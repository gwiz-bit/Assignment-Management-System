@model HighSchoolManagementSystem.Services.DTOs.UpdateStudentDto
@{ ViewData["Title"] = "Cập nhật học sinh"; }
<div class="greeting-banner mb-4"><div><h1 class="greeting-title">Cập nhật học sinh</h1><p class="greeting-subtitle">Chỉnh sửa hồ sơ, liên hệ và trạng thái học sinh.</p></div><a asp-action="Details" asp-route-id="@ViewData["StudentId"]" class="btn btn-secondary">Quay lại hồ sơ</a></div>
<div class="edu-card">
    <form asp-action="Edit" asp-route-id="@ViewData["StudentId"]" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
        <partial name="_Fields" model="Model" />
        <p class="text-muted small">Trạng thái học sinh mô tả tình trạng học tập. Quyền đăng nhập được quản lý tại mục Quản lý tài khoản.</p>
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button><a asp-action="Details" asp-route-id="@ViewData["StudentId"]" class="btn btn-secondary">Hủy</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
