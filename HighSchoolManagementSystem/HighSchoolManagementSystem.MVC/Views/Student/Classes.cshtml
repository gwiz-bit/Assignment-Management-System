@model IEnumerable<HighSchoolManagementSystem.Models.Entities.Class>
@{
    ViewData["Title"] = "Đăng ký lớp";
    var statuses = (Dictionary<int, string>)ViewBag.RegistrationStatus;
}
<div class="container-fluid py-4"><h1 class="h3 mb-3">Đăng ký lớp học</h1>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-warning">@error</div> }
    <div class="row g-3">@foreach (var item in Model) {
        var status = statuses.GetValueOrDefault(item.Id);
        <div class="col-md-6 col-xl-4"><article class="card h-100"><div class="card-body"><span class="badge bg-secondary">@item.GradeLevel.LevelName · @item.AcademicYear.YearCode</span><h2 class="h5 mt-3">@item.ClassName</h2><p>@string.Join(", ", item.TeachingAssignments.Select(t => t.Subject.SubjectName).Distinct())</p>
            @if (status == "Enrolled") { <span class="badge bg-success">Đã tham gia</span> }
            else if (status == "PendingApproval") { <span class="badge bg-warning text-dark">Đang chờ duyệt</span> }
            else if (status == "Rejected") { <form asp-action="RegisterClass" method="post"><input type="hidden" name="classId" value="@item.Id"/><button class="btn btn-outline-primary">Đăng ký lại</button></form> }
            else { <form asp-action="RegisterClass" method="post"><input type="hidden" name="classId" value="@item.Id"/><button class="btn btn-primary">Gửi đăng ký</button></form> }
        </div></article></div>
    }</div>
    @if (!Model.Any()) { <div class="alert alert-info">Chưa có lớp nào mở trong năm học hiện tại.</div> }
</div>
