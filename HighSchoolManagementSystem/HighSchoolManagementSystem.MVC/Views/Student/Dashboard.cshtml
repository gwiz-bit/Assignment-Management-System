@{ ViewData["Title"] = "Student workspace"; var name = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Student"; }
<section class="ams-page-heading"><div><span class="ams-eyebrow">LEARNING WORKSPACE</span><h1>Welcome back, @name</h1><p>Your classes, assignments, and feedback are ready here.</p></div><a asp-controller="Assignments" asp-action="MyAssignments" class="ams-button"><i class="bi bi-journal-check"></i> View assignments</a></section>
<div class="ams-action-grid"><a asp-controller="Student" asp-action="Classes" class="ams-action-card"><span class="ams-action-icon"><i class="bi bi-search"></i></span><h2>Find a subject class</h2><p>Browse available classes and request to join.</p><span class="ams-card-link">Explore classes <i class="bi bi-arrow-right"></i></span></a><a asp-controller="Assignments" asp-action="MyAssignments" class="ams-action-card"><span class="ams-action-icon violet"><i class="bi bi-journal-text"></i></span><h2>My assignments</h2><p>Open your work, submit answers, and check due dates.</p><span class="ams-card-link">Continue working <i class="bi bi-arrow-right"></i></span></a><a asp-controller="Assignments" asp-action="Practice" class="ams-action-card"><span class="ams-action-icon green"><i class="bi bi-stars"></i></span><h2>AI practice</h2><p>Generate extra practice questions for your subjects.</p><span class="ams-card-link">Start practicing <i class="bi bi-arrow-right"></i></span></a><a asp-controller="Student" asp-action="Scores" class="ams-action-card"><span class="ams-action-icon orange"><i class="bi bi-graph-up-arrow"></i></span><h2>My results</h2><p>Review assessment results and teacher feedback.</p><span class="ams-card-link">View results <i class="bi bi-arrow-right"></i></span></a></div>
