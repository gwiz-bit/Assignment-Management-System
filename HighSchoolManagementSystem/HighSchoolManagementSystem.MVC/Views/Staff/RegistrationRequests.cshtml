@model IEnumerable<HighSchoolManagementSystem.Models.Entities.StudentClass>
@{
    ViewData["Title"] = "Yêu cầu đăng ký lớp";
}
<div class="container-fluid py-4"><h1 class="h3 mb-3">Yêu cầu đăng ký lớp</h1>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-warning">@error</div> }
    <div class="table-responsive card"><table class="table table-hover mb-0"><thead><tr><th>Học viên</th><th>Lớp</th><th>Năm học</th><th>Ngày gửi</th><th></th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td>@item.Student.User.FullName (@item.Student.StudentCode)</td><td>@item.Class.ClassName - @item.Class.GradeLevel.LevelName</td><td>@item.Class.AcademicYear.YearCode</td><td>@item.JoinedAt.ToLocalTime().ToString("g")</td><td><form asp-action="ReviewRegistration" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@item.Id"/><button name="approve" value="true" class="btn btn-sm btn-success">Duyệt</button><button name="approve" value="false" class="btn btn-sm btn-outline-danger">Từ chối</button></form></td></tr> }
    </tbody></table></div>
    @if (!Model.Any()) { <p class="text-muted mt-3">Không có yêu cầu đang chờ.</p> }
</div>
