@model HighSchoolManagementSystem.MVC.Models.ViewModels.SemesterListPageViewModel
@{
    ViewData["Title"] = $"Học kỳ - {Model.AcademicYearCode}";
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> QUẢN LÝ ĐÀO TẠO
        </span>
        <h1 class="greeting-title">Học kỳ năm @Model.AcademicYearCode</h1>
        <p class="greeting-subtitle">
            Quản lý danh sách học kỳ thuộc năm học
            @Model.AcademicYearStartDate.ToString("dd/MM/yyyy") – @Model.AcademicYearEndDate.ToString("dd/MM/yyyy").
            @if (Model.IsCurrentAcademicYear)
            {
                <span class="badge-status badge-status-success ms-1">Năm hiện hành</span>
            }
        </p>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Danh sách học kỳ</h2>
            <p class="table-card-subtitle">Thời gian học kỳ phải nằm trong khoảng của năm học.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="table-counter-badge">Tổng: @Model.Semesters.Count học kỳ</span>
            <a asp-action="AcademicYears" class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Năm học
            </a>
            <a asp-action="CreateSemester" asp-route-academicYearId="@Model.AcademicYearId" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Tạo học kỳ
            </a>
        </div>
    </div>

    @if (Model.Semesters.Count == 0)
    {
        <div class="p-4 text-center text-muted">
            <i class="bi bi-journal-x" style="font-size: 2rem;"></i>
            <p class="mt-2 mb-3">Năm học này chưa có học kỳ nào.</p>
            <a asp-action="CreateSemester" asp-route-academicYearId="@Model.AcademicYearId" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Tạo học kỳ đầu tiên
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-edu mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th>Mã học kỳ</th>
                        <th>Tên học kỳ</th>
                        <th>Ngày bắt đầu</th>
                        <th>Ngày kết thúc</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 110px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 1;
                    }
                    @foreach (var item in Model.Semesters)
                    {
                        <tr>
                            <td>@index</td>
                            <td><strong>@item.SemesterCode</strong></td>
                            <td>@item.SemesterName</td>
                            <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <span class="badge-status @item.StatusCssClass">@item.Status</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="EditSemester" asp-route-id="@item.Id"
                                   class="btn btn-secondary btn-sm px-2 py-1" style="font-size: 12px;"
                                   title="Cập nhật">
                                    <i class="bi bi-pencil-square me-1"></i>Sửa
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>
