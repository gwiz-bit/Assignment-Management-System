@model IEnumerable<HighSchoolManagementSystem.Models.Entities.TeachingAssignment>
@{ ViewData["Title"] = "Subject classes"; }
<section class="ams-page-head"><div><span class="ams-eyebrow">SUBJECT CLASSES</span><h1>Lớp học theo môn</h1><p>Mỗi subject class gắn một môn, giáo viên, lớp và học kỳ.</p></div><a asp-action="CreateSubjectClass" class="ams-button ams-button-primary"><i class="bi bi-plus-lg"></i> Tạo subject class</a></section>
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success">@message</div> }
<section class="ams-panel p-0 overflow-hidden"><div class="table-responsive"><table class="table ams-table mb-0"><thead><tr><th>Môn học</th><th>Class group</th><th>Giáo viên</th><th>Học kỳ</th><th>Năm học</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Subject.SubjectName</strong><small>@item.Subject.SubjectCode</small></td><td>@item.Class.ClassName</td><td>@item.Teacher.User.FullName</td><td>@item.Semester.SemesterName</td><td>@item.Semester.AcademicYear.YearCode</td><td><span class="ams-status @(item.Status == "Assigned" ? "is-active" : "is-muted")">@item.Status</span></td></tr> }</tbody></table></div>
@if (!Model.Any()) { <div class="ams-empty"><i class="bi bi-diagram-3"></i><h2>Chưa có subject class</h2><p>Tạo lớp môn đầu tiên để mở đăng ký.</p><a asp-action="CreateSubjectClass" class="ams-button ams-button-primary">Tạo subject class</a></div> }</section>
