@{ ViewData["Title"] = "Expert workspace"; }
<section class="ams-page-head"><div><span class="ams-eyebrow">EXPERT WORKSPACE</span><h1>Không gian chuyên môn</h1><p>Chuẩn bị mẫu bài tập và tổ chức các lớp học theo môn.</p></div><a asp-controller="Assignments" asp-action="CreateTemplate" class="ams-button ams-button-primary"><i class="bi bi-plus-lg"></i> Tạo assignment template</a></section>
<section class="ams-metric-grid ams-metric-grid-3"><article class="ams-metric"><span class="ams-metric-icon indigo"><i class="bi bi-journal-text"></i></span><span class="ams-metric-label">Templates</span><strong>@ViewBag.TemplateCount</strong><small>Tất cả mẫu bài tập</small></article><article class="ams-metric"><span class="ams-metric-icon violet"><i class="bi bi-send"></i></span><span class="ams-metric-label">Đã công khai</span><strong>@ViewBag.PublishedCount</strong><small>Sẵn sàng cho học viên</small></article><article class="ams-metric"><span class="ams-metric-icon cyan"><i class="bi bi-diagram-3"></i></span><span class="ams-metric-label">Subject classes</span><strong>@ViewBag.SubjectClassCount</strong><small>Trong học kỳ hiện tại</small></article></section>
<section class="ams-panel"><div class="ams-panel-head"><div><span class="ams-eyebrow">GET STARTED</span><h2>Quản lý nội dung học tập</h2></div></div><div class="ams-quick-grid"><a asp-controller="Assignments" asp-action="Templates"><i class="bi bi-journal-text"></i><strong>Assignment templates</strong><small>Tạo, rà soát và công khai nội dung</small></a><a asp-action="SubjectClasses"><i class="bi bi-diagram-3"></i><strong>Subject classes</strong><small>Xem lớp học theo môn</small></a><a asp-action="CreateSubjectClass"><i class="bi bi-plus-square"></i><strong>Mở subject class</strong><small>Phân công môn, lớp, giáo viên, học kỳ</small></a></div></section>
