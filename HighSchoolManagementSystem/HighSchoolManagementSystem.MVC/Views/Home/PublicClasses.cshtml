@model IEnumerable<HighSchoolManagementSystem.Models.Entities.TeachingAssignment>
@{ ViewData["Title"] = "Public subject classes"; }
<section class="ams-page-heading"><div><span class="ams-eyebrow">EXPLORE AMS</span><h1>Public subject classes</h1><p>Find a subject class and create a student account to request enrollment.</p></div><a asp-controller="Auth" asp-action="Register" class="ams-button">Create account <i class="bi bi-arrow-right"></i></a></section>
<div class="ams-public-grid">@foreach(var item in Model){<article class="ams-public-card"><span class="ams-subject-code">@item.Subject.SubjectCode</span><h2>@item.Subject.SubjectName</h2><p><i class="bi bi-people"></i> Class @item.Class.ClassName · Grade @item.Class.GradeLevel.LevelName</p><p><i class="bi bi-calendar3"></i> @item.Semester.SemesterName</p><p><i class="bi bi-person"></i> @item.Teacher.User.FullName</p><a asp-controller="Auth" asp-action="Register">Join class <i class="bi bi-arrow-right"></i></a></article>}</div>
@if(!Model.Any()){<div class="ams-empty-state"><i class="bi bi-collection"></i><h2>No public classes yet</h2><p>Check back later for classes accepting students.</p></div>}
