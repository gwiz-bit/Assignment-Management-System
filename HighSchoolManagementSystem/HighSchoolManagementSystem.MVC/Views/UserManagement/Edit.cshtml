@model HighSchoolManagementSystem.MVC.Models.ViewModels.UserManagement.EditUserViewModel
@{
    ViewData["Title"] = "Cập Nhật Tài Khoản";
    var roles = ViewBag.Roles as List<HighSchoolManagementSystem.MVC.Models.ViewModels.UserManagement.RoleOptionViewModel> ?? new();
}

<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap"><span class="greeting-kicker"><i class="bi bi-pencil-square me-1"></i> CẬP NHẬT TÀI KHOẢN • QUẢN TRỊ HỆ THỐNG</span><h1 class="greeting-title">Cập Nhật Tài Khoản</h1><p class="greeting-subtitle">Chỉnh sửa thông tin và vai trò truy cập của người dùng.</p></div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary px-3 py-2 shadow-sm"><i class="bi bi-arrow-left"></i><span>Quay Lại Chi Tiết</span></a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="edu-card shadow-sm">
            <div class="edu-card-header"><h2 class="edu-card-title"><i class="bi bi-person-lines-fill text-primary me-2"></i>Biểu Mẫu Cập Nhật Tài Khoản</h2></div>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="p-4">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-6"><label class="form-label">Tên đăng nhập</label><div class="input-group"><span class="input-group-text bg-light text-muted"><i class="bi bi-lock-fill"></i></span><input asp-for="Username" class="form-control bg-light font-monospace" readonly /></div><div class="form-text">Tên đăng nhập không thể thay đổi.</div></div>
                    <div class="col-12 col-md-6"><label asp-for="Email" class="form-label required">Email <span class="text-danger">*</span></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="FullName" class="form-label required">Họ và tên <span class="text-danger">*</span></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="PhoneNumber" class="form-label">Số điện thoại</label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger small"></span></div>
                    <div class="col-6 col-md-3"><label asp-for="Gender" class="form-label">Giới tính</label><select asp-for="Gender" class="form-select"><option value="">-- Chọn --</option><option>Nam</option><option>Nữ</option><option>Khác</option></select></div>
                    <div class="col-6 col-md-3"><label asp-for="DateOfBirth" class="form-label">Ngày sinh</label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label asp-for="RoleId" class="form-label required">Vai trò <span class="text-danger">*</span></label><select asp-for="RoleId" class="form-select">@foreach (var role in roles) { <option value="@role.Id">@role.Name</option> }</select><span asp-validation-for="RoleId" class="text-danger small"></span></div>
                </div>
                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary px-4"><i class="bi bi-x-circle me-1"></i>Hủy Bỏ</a><button type="submit" class="btn btn-info px-4 shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>Lưu Thay Đổi</button></div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
