@model HighSchoolManagementSystem.MVC.Models.ViewModels.UserManagement.ResetUserPasswordViewModel
@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu";
}

<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap"><span class="greeting-kicker"><i class="bi bi-key-fill me-1"></i> BẢO MẬT TÀI KHOẢN • QUẢN TRỊ HỆ THỐNG</span><h1 class="greeting-title">Đặt Lại Mật Khẩu</h1><p class="greeting-subtitle">Cấp mật khẩu mới cho tài khoản người dùng.</p></div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary px-3 py-2 shadow-sm"><i class="bi bi-arrow-left"></i><span>Quay Lại Chi Tiết</span></a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="edu-card shadow-sm">
            <div class="edu-card-header"><h2 class="edu-card-title"><i class="bi bi-shield-lock-fill text-primary me-2"></i>Đặt Lại Mật Khẩu</h2></div>
            <form asp-action="ResetPassword" method="post" class="p-4">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" /><input asp-for="Username" type="hidden" /><input asp-for="FullName" type="hidden" />
                <div class="alert alert-info d-flex align-items-center gap-2" role="alert"><i class="bi bi-info-circle-fill"></i><span>Đang cập nhật cho <strong>@Model.FullName</strong> (<span class="font-monospace">@@@Model.Username</span>).</span></div>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
                <div class="mb-3"><label asp-for="NewPassword" class="form-label required">Mật khẩu mới <span class="text-danger">*</span></label><input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" /><span asp-validation-for="NewPassword" class="text-danger small"></span></div>
                <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label required">Xác nhận mật khẩu <span class="text-danger">*</span></label><input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary px-4"><i class="bi bi-x-circle me-1"></i>Hủy Bỏ</a><button type="submit" class="btn btn-primary px-4 shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>Xác Nhận</button></div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
