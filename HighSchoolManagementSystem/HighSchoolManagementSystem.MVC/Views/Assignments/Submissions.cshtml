@model IEnumerable<HighSchoolManagementSystem.Models.Entities.AssignmentSubmission>
@{
    ViewData["Title"] = "Đánh giá bài nộp";
}
<div class="container-fluid py-4"><h1 class="h3 mb-3">Bài nộp cần đánh giá</h1>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    <div class="row g-3">@foreach (var item in Model) {
        <div class="col-12"><article class="card card-body"><div class="d-flex justify-content-between"><div><span class="badge bg-secondary">@item.AssignmentTemplate.Subject.SubjectName</span><h2 class="h5 mt-2">@item.AssignmentTemplate.Title</h2><p class="text-muted mb-2">@item.Student.User.FullName · @item.SubmittedAt.ToLocalTime().ToString("g")</p></div><span>@(item.EvaluatedAt.HasValue ? "Đã đánh giá" : "Chờ đánh giá")</span></div>
            <div class="border rounded p-3 mb-3" style="white-space:pre-wrap">@item.Answer</div>
            <form asp-action="Grade" method="post" class="row g-2 align-items-end"><input type="hidden" name="SubmissionId" value="@item.Id"/><div class="col-sm-2"><label class="form-label">Điểm / 100</label><input type="number" name="Score" min="0" max="100" step="0.01" value="@item.Score" class="form-control" required/></div><div class="col-sm-8"><label class="form-label">Nhận xét</label><input name="TeacherFeedback" value="@item.TeacherFeedback" maxlength="2000" class="form-control"/></div><div class="col-sm-2"><button class="btn btn-primary w-100">Lưu đánh giá</button></div></form>
        </article></div>
    }</div>
</div>
