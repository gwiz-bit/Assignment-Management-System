@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string c, string? a = null) => controller == c && (a == null || action == a) ? "active" : "";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
}
<aside class="app-sidebar">
    <a asp-controller="Home" asp-action="Index" class="ams-brand">
        <span class="ams-brand-mark">A</span><span class="ams-brand-copy"><strong>AMS</strong><small>Assignment Management</small></span>
    </a>
    <div class="ams-sidebar-caption">WORKSPACE · @role.ToUpperInvariant()</div>
    <nav class="ams-nav">
        @if (User.IsInRole("Admin"))
        {
            <span class="ams-nav-label">OVERVIEW</span>
            <a class="ams-nav-link @Active("Admin", "Dashboard")" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
            <a class="ams-nav-link @Active("Admin", "ClassRegistrations")" asp-controller="Admin" asp-action="ClassRegistrations"><i class="bi bi-person-check"></i><span>Class registrations</span></a>
            <span class="ams-nav-label">SYSTEM ADMIN</span>
            <a class="ams-nav-link @Active("UserManagement")" asp-controller="UserManagement" asp-action="Index"><i class="bi bi-people"></i><span>Accounts</span></a>
            <a class="ams-nav-link @Active("Subject")" asp-controller="Subject" asp-action="Index"><i class="bi bi-book"></i><span>Subjects</span></a>
            <a class="ams-nav-link @Active("Expert", "SubjectClasses")" asp-controller="Expert" asp-action="SubjectClasses"><i class="bi bi-diagram-3"></i><span>Subject classes</span></a>
        }
        else if (User.IsInRole("Expert"))
        {
            <span class="ams-nav-label">CONTENT DESIGN</span>
            <a class="ams-nav-link @Active("Expert", "Dashboard")" asp-controller="Expert" asp-action="Dashboard"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
            <a class="ams-nav-link @Active("Assignments", "Templates")" asp-controller="Assignments" asp-action="Templates"><i class="bi bi-journal-text"></i><span>Assignment templates</span></a>
            <a class="ams-nav-link @Active("Expert", "SubjectClasses")" asp-controller="Expert" asp-action="SubjectClasses"><i class="bi bi-diagram-3"></i><span>Subject classes</span></a>
        }
        else if (User.IsInRole("Teacher"))
        {
            <span class="ams-nav-label">TEACHING</span>
            <a class="ams-nav-link @Active("Teacher", "Dashboard")" asp-controller="Teacher" asp-action="Dashboard"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
            <a class="ams-nav-link @Active("Teacher", "MyClasses")" asp-controller="Teacher" asp-action="MyClasses"><i class="bi bi-collection"></i><span>My subject classes</span></a>
            <a class="ams-nav-link @Active("Assignments", "CreateTemplate")" asp-controller="Assignments" asp-action="CreateTemplate"><i class="bi bi-plus-square"></i><span>Create assignment</span></a>
            <a class="ams-nav-link @Active("Assignments", "Submissions")" asp-controller="Assignments" asp-action="Submissions"><i class="bi bi-clipboard-check"></i><span>Evaluate submissions</span></a>
            <a class="ams-nav-link @Active("Assessment")" asp-controller="Assessment" asp-action="Index"><i class="bi bi-card-checklist"></i><span>Assessments</span></a>
            <a class="ams-nav-link @Active("Score", "SubjectMatrix")" asp-controller="Score" asp-action="SubjectMatrix"><i class="bi bi-table"></i><span>Gradebook</span></a>
        }
        else if (User.IsInRole("Student"))
        {
            <span class="ams-nav-label">LEARNING</span>
            <a class="ams-nav-link @Active("Student", "Dashboard")" asp-controller="Student" asp-action="Dashboard"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
            <a class="ams-nav-link @Active("Student", "Classes")" asp-controller="Student" asp-action="Classes"><i class="bi bi-search"></i><span>Find a class</span></a>
            <a class="ams-nav-link @Active("Assignments", "MyAssignments")" asp-controller="Assignments" asp-action="MyAssignments"><i class="bi bi-journal-check"></i><span>My assignments</span></a>
            <a class="ams-nav-link @Active("Assignments", "Practice")" asp-controller="Assignments" asp-action="Practice"><i class="bi bi-stars"></i><span>AI practice</span></a>
            <a class="ams-nav-link @Active("Student", "Scores")" asp-controller="Student" asp-action="Scores"><i class="bi bi-graph-up"></i><span>My results</span></a>
        }
        else
        {
            <span class="ams-nav-label">EXPLORE</span>
            <a class="ams-nav-link @Active("Home", "Index")" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i><span>Home</span></a>
            <a class="ams-nav-link @Active("Home", "PublicClasses")" asp-controller="Home" asp-action="PublicClasses"><i class="bi bi-collection"></i><span>Public classes</span></a>
            <a class="ams-nav-link @Active("Assignments", "PublicTemplates")" asp-controller="Assignments" asp-action="PublicTemplates"><i class="bi bi-journal-text"></i><span>Public assignments</span></a>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="ams-nav-label ams-nav-label-bottom">ACCOUNT</span>
            <a class="ams-nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle"></i><span>Profile</span></a>
        }
    </nav>
    <div class="ams-sidebar-foot"><span class="ams-status-dot"></span><span>AMS workspace</span><small>v1.0</small></div>
</aside>
