@{ var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Member"; var name = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Member"; var avatar = User.FindFirst("AvatarUrl")?.Value; var initial = string.IsNullOrWhiteSpace(name) ? "A" : name[..1].ToUpperInvariant(); var roleLabel = role switch { "Admin" => "Administrator", "Expert" => "Subject expert", "Teacher" => "Teacher", "Student" => "Student", _ => role }; }
<header class="app-topbar ams-topbar"><div class="topbar-left"><button type="button" class="topbar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle navigation"><i class="bi bi-list"></i></button><div class="ams-topbar-context"><span>AMS</span><i class="bi bi-chevron-right"></i><span>@roleLabel workspace</span></div></div><div class="topbar-right"><a asp-controller="Profile" asp-action="Index" class="user-profile-pill text-decoration-none"><div class="user-avatar overflow-hidden">@if (!string.IsNullOrEmpty(avatar)){<img src="@avatar" alt="@name" style="width:100%;height:100%;object-fit:cover;border-radius:50%" />}else{@initial}</div><div class="user-meta"><span class="user-name">@name</span><span class="user-role-tag">@roleLabel</span></div></a><form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline mb-0">@Html.AntiForgeryToken()<button type="submit" class="btn-logout-clean" title="Sign out"><i class="bi bi-box-arrow-right"></i><span class="d-none d-sm-inline">Sign out</span></button></form></div></header>
