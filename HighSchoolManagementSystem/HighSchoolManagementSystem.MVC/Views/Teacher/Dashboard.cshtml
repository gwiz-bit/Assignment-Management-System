@{ ViewData["Title"] = "Teacher workspace"; var name = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Teacher"; }
<section class="ams-page-heading"><div><span class="ams-eyebrow">TEACHING WORKSPACE</span><h1>Welcome back, @name</h1><p>Manage your subject classes, assignments, and student submissions.</p></div><a asp-controller="Assignments" asp-action="CreateTemplate" class="ams-button"><i class="bi bi-plus-lg"></i> Create assignment</a></section>
<div class="ams-action-grid"><a asp-controller="Teacher" asp-action="MyClasses" class="ams-action-card"><span class="ams-action-icon"><i class="bi bi-collection"></i></span><h2>My subject classes</h2><p>Open your classes and continue teaching.</p><span class="ams-card-link">View classes <i class="bi bi-arrow-right"></i></span></a><a asp-controller="Assignments" asp-action="CreateTemplate" class="ams-action-card"><span class="ams-action-icon violet"><i class="bi bi-journal-plus"></i></span><h2>Create an assignment</h2><p>Prepare and publish work for your students.</p><span class="ams-card-link">Create assignment <i class="bi bi-arrow-right"></i></span></a><a asp-controller="Assignments" asp-action="Submissions" class="ams-action-card"><span class="ams-action-icon green"><i class="bi bi-clipboard-check"></i></span><h2>Evaluate submissions</h2><p>Review student work and provide feedback.</p><span class="ams-card-link">Open submissions <i class="bi bi-arrow-right"></i></span></a><a asp-controller="Score" asp-action="SubjectMatrix" class="ams-action-card"><span class="ams-action-icon orange"><i class="bi bi-table"></i></span><h2>Gradebook</h2><p>Continue using your existing assessment and grade workflows.</p><span class="ams-card-link">Open gradebook <i class="bi bi-arrow-right"></i></span></a></div>
