@model HighSchoolManagementSystem.MVC.Models.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Sign in"; ViewData["HideNav"] = true; }
<main class="ams-auth-shell"><a asp-controller="Home" asp-action="Index" class="ams-brand"><span class="ams-brand-mark">A</span><span class="ams-brand-copy"><strong>AMS</strong><small>Assignment Management System</small></span></a><section class="ams-auth-card"><span class="ams-eyebrow">WELCOME BACK</span><h1>Sign in to AMS</h1><p>Continue to your teaching or learning workspace.</p>@if(TempData["SuccessMessage"]!=null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}@if(TempData["ErrorMessage"]!=null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><form asp-controller="Auth" asp-action="Login" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="ReturnUrl"/><div class="mb-3"><label asp-for="UsernameOrEmail" class="form-label">Username or email</label><input asp-for="UsernameOrEmail" class="form-control" placeholder="Your account name" autofocus/><span asp-validation-for="UsernameOrEmail" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control" placeholder="Your password"/><span asp-validation-for="Password" class="text-danger small"></span></div><div class="d-flex justify-content-between align-items-center mb-4"><div class="form-check"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label">Remember me</label></div><a asp-action="ForgotPassword" class="ams-card-link">Forgot password?</a></div><button type="submit" class="ams-button w-100">Sign in <i class="bi bi-arrow-right"></i></button></form><div class="ams-auth-bottom">New to AMS? <a asp-action="Register">Create a student account</a></div></section><a asp-controller="Home" asp-action="Index" class="ams-auth-back"><i class="bi bi-arrow-left"></i> Back to home</a></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
